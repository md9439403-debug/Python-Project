import rarfile
rar_path= "Hud&Keymapping.rar"
p = "pass6.txt"
rf = rarfile.RarFile(rar_path)
with open(p, 'r') as f:
    for password in f:
        new_password = password.strip()
        try:
            rf.extractall(pwd=new_password.encode('utf-8'))
            print(f"Password found: {new_password}")
            break
        except Exception as e:
            print(f"Trying password: {new_password} - Failed")
